      "retryOnFail": true,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "qpsKeBMmSg6Voeua",
          "name": "Header Auth account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// دریافت تمام آیتم‌ها از نود HTTP Request و ترکیب خلاصه ۳ خبر\nconst items = $input.all();\n\nlet formattedDigest = \"🚀 **Daily AI Executive Briefing**\\n\\n\";\n\nitems.forEach((item, index) => {\n  // گرفتن اطلاعات خبر اصلی از نود Limit یا RSS\n  const originalNews = $('Limit').all()[index].json;\n  const title = originalNews.title || \"Latest AI Update\";\n  const link = originalNews.link || \"\";\n  \n  // استخراج متن خلاصه از پاسخ مدل\n  const summary = item.json.choices?.[0]?.message?.content || \"No summary available.\";\n  \n  formattedDigest += `📰 **${index + 1}. ${title}**\\n`;\n  formattedDigest += `${summary}\\n`;\n  if (link) {\n    formattedDigest += `🔗 [Read Full Story](${link})\\n`;\n  }\n  formattedDigest += \"\\n\" + \"—\".repeat(20) + \"\\n\\n\";\n});\n\nreturn [\n  {\n    json: {\n      digest: formattedDigest.trim(),\n      generatedAt: new Date().toISOString(),\n      articlesCount: items.length\n    }\n  }\n];\n"
      },
