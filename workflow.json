        "jsonBody": "={{\nJSON.stringify({\n  \"model\": \"openrouter/free\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a concise AI news summarizer. For the given article, provide a 2-bullet point executive summary.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Title: \" + ($json.title || \"\") + \"\\n\\nContent: \" + ($json.contentSnippet || $json.content || \"\")\n    }\n  ],\n  \"temperature\": 0.3\n})\n}}\n",
        "options": {}
      },
